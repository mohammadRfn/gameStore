mn index="10" value="98"/><column index="11" value="84"/><column index="12" value="50"/><column index="13" value="112"/><column index="14" value="116"/><column index="15" value="89"/><column index="16" value="92"/><column index="17" value="90"/><column index="18" value="76"/><column index="19" value="74"/><column index="20" value="152"/><column index="21" value="91"/><column index="22" value="46"/><column index="23" value="92"/><column index="24" value="68"/><column index="25" value="68"/><column index="26" value="72"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- حذف جدول و ایندکس‌های قبلی (اگر وجود دارند)
DROP INDEX IF EXISTS idx_archive_actions_archived_record;
DROP INDEX IF EXISTS idx_archive_actions_source;
DROP INDEX IF EXISTS idx_archive_actions_action;

DROP TABLE IF EXISTS archive_actions;

-- حالا جدول را بساز
CREATE TABLE archive_actions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,

    archived_record_id INTEGER,

    source_type TEXT CHECK(length(source_type) &lt;= 20),
    source_id INTEGER,

    action TEXT NOT NULL CHECK(length(action) &lt;= 20),

    actor_id INTEGER,

    reason TEXT,
    payload_json TEXT,

    created_at TEXT DEFAULT (datetime('now'))
);

-- ایندکس‌ها
CREATE INDEX idx_archive_actions_archived_record ON archive_actions (archived_record_id);
CREATE INDEX idx_archive_actions_source ON archive_actions (source_type, source_id);
CREATE INDEX idx_archive_actions_action ON archive_actions (action);</sql><current_tab id="0"/></tab_sql></sqlb_project>
