<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="database.sqlite" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="10957"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="adjustment_categories" custom_title="0" dock_id="1" table="4,21:mainadjustment_categories"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">BEGIN TRANSACTION;

CREATE TABLE IF NOT EXISTS settings (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    [group] TEXT NOT NULL,
    [key] TEXT NOT NULL,
    [value] TEXT,
    [type] TEXT NOT NULL DEFAULT 'string',
    created_at TEXT,
    updated_at TEXT,
    UNIQUE ([group], [key])
);

INSERT OR REPLACE INTO settings (
    [group],
    [key],
    [value],
    [type],
    created_at,
    updated_at
)
VALUES
    -- GENERAL
    ('general', 'date_calendar', 'jalali', 'string', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('general', 'time_format', '24', 'string', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('general', 'decimal_separator', '.', 'string', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('general', 'currency_label', 'تومان', 'string', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('general', 'theme', 'dark', 'string', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),

    -- TAX
    ('tax', 'default_rate', '9', 'float', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('tax', 'inclusive', '0', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('tax', 'apply_to_service_labor', '1', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),

    -- INVOICE
    ('invoice', 'number_prefix', 'INV-', 'string', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('invoice', 'next_number', '1000', 'integer', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('invoice', 'footer_note', '', 'string', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('invoice', 'registration_number', '', 'string', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('invoice', 'default_paper_size', 'A4', 'string', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('invoice', 'default_printer', '', 'string', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),

    -- SYSTEM
    ('system', 'launch_on_startup', '0', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('system', 'minimize_to_tray', '1', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('system', 'auto_backup_enabled', '0', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('system', 'auto_backup_interval_days', '7', 'integer', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('system', 'update_channel', 'stable', 'string', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),

    -- MAINTENANCE CACHE
    (
        'maintenance.cache',
        'default_targets',
        '[&quot;app&quot;,&quot;settings&quot;,&quot;config&quot;,&quot;route&quot;,&quot;view&quot;,&quot;event&quot;,&quot;compiled&quot;,&quot;bootstrap&quot;,&quot;framework_files&quot;,&quot;expired_database_cache&quot;]',
        'json',
        CURRENT_TIMESTAMP,
        CURRENT_TIMESTAMP
    ),
    ('maintenance.cache', 'allow_log_cleanup', '0', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('maintenance.cache', 'logs_older_than_days', '14', 'integer', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('maintenance.cache', 'allow_session_cleanup', '0', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('maintenance.cache', 'warm_after_clear', '0', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('maintenance.cache', 'warm_config', '0', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('maintenance.cache', 'warm_views', '1', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('maintenance.cache', 'warm_settings', '1', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP),
    ('maintenance.cache', 'run_sqlite_vacuum', '0', 'boolean', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP);

COMMIT;

SELECT *
FROM settings
ORDER BY [group], [key];</sql><current_tab id="0"/></tab_sql></sqlb_project>
