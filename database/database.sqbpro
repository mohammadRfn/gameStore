<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="database.sqlite" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="13391"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="app_settings" custom_title="0" dock_id="1" table="4,12:mainapp_settings"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- ═══════════════════════════════════════════════════════════════════════════════
-- GameStore · Enterprise Cache Cleaner · SQLite SQL
-- هماهنگ با ساختار app_settings / setting_groups فعلی پروژه
-- ═══════════════════════════════════════════════════════════════════════════════

-- 1) جدول تاریخچه عملیات پاکسازی کش
CREATE TABLE IF NOT EXISTS cache_maintenance_runs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    operation TEXT NOT NULL DEFAULT 'clear',
    status TEXT NOT NULL DEFAULT 'pending',
    is_dry_run INTEGER NOT NULL DEFAULT 0,
    targets_json TEXT DEFAULT NULL,
    options_json TEXT DEFAULT NULL,
    before_metrics_json TEXT DEFAULT NULL,
    after_metrics_json TEXT DEFAULT NULL,
    summary_json TEXT DEFAULT NULL,
    errors_json TEXT DEFAULT NULL,
    console_output TEXT DEFAULT NULL,
    user_id INTEGER DEFAULT NULL REFERENCES users(id) ON DELETE SET NULL,
    started_at TEXT DEFAULT NULL,
    finished_at TEXT DEFAULT NULL,
    duration_ms INTEGER DEFAULT NULL,
    created_at TEXT DEFAULT NULL,
    updated_at TEXT DEFAULT NULL
);

CREATE INDEX IF NOT EXISTS idx_cache_maintenance_runs_operation ON cache_maintenance_runs(operation);
CREATE INDEX IF NOT EXISTS idx_cache_maintenance_runs_status ON cache_maintenance_runs(status);
CREATE INDEX IF NOT EXISTS idx_cache_maintenance_runs_dry_run ON cache_maintenance_runs(is_dry_run);
CREATE INDEX IF NOT EXISTS idx_cache_maintenance_runs_started_at ON cache_maintenance_runs(started_at);
CREATE INDEX IF NOT EXISTS idx_cache_maintenance_runs_finished_at ON cache_maintenance_runs(finished_at);
CREATE INDEX IF NOT EXISTS idx_cache_maintenance_runs_operation_status ON cache_maintenance_runs(operation, status);
CREATE INDEX IF NOT EXISTS idx_cache_maintenance_runs_user_created ON cache_maintenance_runs(user_id, created_at);

-- 2) گروه تنظیمات نگهداری سیستم
INSERT OR IGNORE INTO setting_groups (code, label, icon, description, sort_order, created_at, updated_at)
VALUES ('maintenance', 'نگهداری سیستم', '🧹', 'پاکسازی کش، بهینه‌سازی و سلامت اجرای محلی برنامه', 9, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP);

-- 3) تنظیمات مربوط به Cache Cleaner
INSERT OR IGNORE INTO app_settings
(group_id, setting_key, setting_value, value_type, default_value, is_locked, is_autoload, is_encrypted, description, updated_by, created_at, updated_at)
SELECT id, 'maintenance.cache.default_targets',
       '[&quot;app&quot;,&quot;settings&quot;,&quot;config&quot;,&quot;route&quot;,&quot;view&quot;,&quot;event&quot;,&quot;compiled&quot;,&quot;optimize&quot;,&quot;bootstrap&quot;,&quot;framework_files&quot;,&quot;expired_database_cache&quot;]',
       'json',
       '[&quot;app&quot;,&quot;settings&quot;,&quot;config&quot;,&quot;route&quot;,&quot;view&quot;,&quot;event&quot;,&quot;compiled&quot;,&quot;optimize&quot;,&quot;bootstrap&quot;,&quot;framework_files&quot;,&quot;expired_database_cache&quot;]',
       0, 0, 0, 'Targetهای پیش‌فرض پاکسازی کش', NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
FROM setting_groups WHERE code = 'maintenance';

INSERT OR IGNORE INTO app_settings
(group_id, setting_key, setting_value, value_type, default_value, is_locked, is_autoload, is_encrypted, description, updated_by, created_at, updated_at)
SELECT id, 'maintenance.cache.warm_after_clear', '0', 'boolean', '0', 0, 0, 0, 'گرم‌سازی خودکار بعد از پاکسازی', NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
FROM setting_groups WHERE code = 'maintenance';

INSERT OR IGNORE INTO app_settings
(group_id, setting_key, setting_value, value_type, default_value, is_locked, is_autoload, is_encrypted, description, updated_by, created_at, updated_at)
SELECT id, 'maintenance.cache.warm_config', '0', 'boolean', '0', 0, 0, 0, 'بازسازی config cache بعد از پاکسازی', NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
FROM setting_groups WHERE code = 'maintenance';

INSERT OR IGNORE INTO app_settings
(group_id, setting_key, setting_value, value_type, default_value, is_locked, is_autoload, is_encrypted, description, updated_by, created_at, updated_at)
SELECT id, 'maintenance.cache.warm_views', '1', 'boolean', '1', 0, 0, 0, 'کامپایل مجدد viewها بعد از پاکسازی', NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
FROM setting_groups WHERE code = 'maintenance';

INSERT OR IGNORE INTO app_settings
(group_id, setting_key, setting_value, value_type, default_value, is_locked, is_autoload, is_encrypted, description, updated_by, created_at, updated_at)
SELECT id, 'maintenance.cache.warm_settings', '1', 'boolean', '1', 0, 0, 0, 'گرم‌سازی کش تنظیمات بعد از پاکسازی', NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
FROM setting_groups WHERE code = 'maintenance';

INSERT OR IGNORE INTO app_settings
(group_id, setting_key, setting_value, value_type, default_value, is_locked, is_autoload, is_encrypted, description, updated_by, created_at, updated_at)
SELECT id, 'maintenance.cache.allow_log_cleanup', '0', 'boolean', '0', 0, 0, 0, 'اجازه حذف لاگ‌های قدیمی', NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
FROM setting_groups WHERE code = 'maintenance';

INSERT OR IGNORE INTO app_settings
(group_id, setting_key, setting_value, value_type, default_value, is_locked, is_autoload, is_encrypted, description, updated_by, created_at, updated_at)
SELECT id, 'maintenance.cache.logs_older_than_days', '14', 'integer', '14', 0, 0, 0, 'حداقل سن لاگ برای حذف (روز)', NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
FROM setting_groups WHERE code = 'maintenance';

INSERT OR IGNORE INTO app_settings
(group_id, setting_key, setting_value, value_type, default_value, is_locked, is_autoload, is_encrypted, description, updated_by, created_at, updated_at)
SELECT id, 'maintenance.cache.allow_session_cleanup', '0', 'boolean', '0', 0, 0, 0, 'اجازه حذف session فایل‌ها', NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
FROM setting_groups WHERE code = 'maintenance';

INSERT OR IGNORE INTO app_settings
(group_id, setting_key, setting_value, value_type, default_value, is_locked, is_autoload, is_encrypted, description, updated_by, created_at, updated_at)
SELECT id, 'maintenance.cache.run_sqlite_vacuum', '0', 'boolean', '0', 0, 0, 0, 'اجرای VACUUM/ANALYZE SQLite بعد از پاکسازی', NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
FROM setting_groups WHERE code = 'maintenance';

INSERT OR IGNORE INTO app_settings
(group_id, setting_key, setting_value, value_type, default_value, is_locked, is_autoload, is_encrypted, description, updated_by, created_at, updated_at)
SELECT id, 'maintenance.cache.keep_history_days', '90', 'integer', '90', 0, 0, 0, 'مدت نگهداری تاریخچه پاکسازی کش (روز)', NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
FROM setting_groups WHERE code = 'maintenance';

-- 4) کوئری‌های گزارش و مانیتورینگ

-- آخرین عملیات‌ها
SELECT id, operation, status, is_dry_run, duration_ms, user_id, started_at, finished_at
FROM cache_maintenance_runs
ORDER BY id DESC
LIMIT 20;

-- آخرین خطاها
SELECT id, operation, status, errors_json, started_at
FROM cache_maintenance_runs
WHERE status IN ('failed', 'partial')
ORDER BY id DESC
LIMIT 20;

-- آمار موفقیت/خطا
SELECT status, COUNT(*) AS total
FROM cache_maintenance_runs
GROUP BY status;

-- حذف تاریخچه قدیمی بر اساس تنظیمات
DELETE FROM cache_maintenance_runs
WHERE created_at &lt; datetime('now', '-' || COALESCE((
    SELECT setting_value FROM app_settings WHERE setting_key = 'maintenance.cache.keep_history_days'
), '90') || ' days');
</sql><current_tab id="0"/></tab_sql></sqlb_project>
